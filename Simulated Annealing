import math
import random

def simulated_annealing():
    current = int(input("Enter initial solution: "))
    temperature = float(input("Enter initial temperature: "))
    cooling_rate = float(input("Enter cooling rate (0 to 1): "))
    iterations = int(input("Enter number of iterations: "))

    def objective(x):
        return -x * x + 10 * x  # Maximize this function

    best = current

    for i in range(iterations):
        new = current + random.randint(-1, 1)

        delta = objective(new) - objective(current)

        if delta > 0:
            current = new
        else:
            probability = math.exp(delta / temperature)

            if random.random() < probability:
                current = new

        if objective(current) > objective(best):
            best = current

        temperature *= cooling_rate

        if temperature < 0.0001:
            break

    print("Best solution:", best)
    print("Best value:", objective(best))


simulated_annealing()
